# Copy this file to .env for local development and fill in real values.
# In Railway, set these under Project -> Variables instead of committing a .env file.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" for local dev, unset or "False" in production.
DEBUG=True

# Postgres connection string, e.g. postgresql://user:password@host:5432/dbname
# Railway injects this automatically when you attach a Postgres plugin.
# Leave unset locally to fall back to sqlite (db.sqlite3).
DATABASE_URL=

# Set automatically by Railway to the service's public hostname
# (e.g. nfl-pool-production.up.railway.app). Used for ALLOWED_HOSTS /
# CSRF_TRUSTED_ORIGINS. Leave unset for local dev.
RAILWAY_PUBLIC_DOMAIN=

# Optional comma-separated extra hosts to allow (e.g. a custom domain),
# added on top of RAILWAY_PUBLIC_DOMAIN.
ALLOWED_HOSTS=

# The Odds API key — https://the-odds-api.com
ODDS_API_KEY=
